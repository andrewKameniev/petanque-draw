    "register-service-worker": "^1.7.2",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "vue3-apexcharts": "1.11.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
