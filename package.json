  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:eslint": "eslint .",
    "lint": "npm run lint:eslint && npm run stylelint && npm run format:check",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
    "stylelint": "stylelint \"src/**/*.{vue,css}\"",
