{
  "name": "petanque-draw",
  "version": "1.36.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui-primitives": "vitest run src/__tests__/navigation-loading-scroll.mounted.spec.js src/__tests__/round-timer.mounted.spec.js src/__tests__/tir-primitives.mounted.spec.js src/__tests__/training-view.mounted.spec.js src/__tests__/ui-primitives.mounted.spec.js src/__tests__/ui-primitives.spec.js",
    "test:ui-a11y": "playwright test --config playwright.a11y.config.js",
    "test:ui-visual": "playwright test --config playwright.visual.config.js",
    "test:tooling": "vitest run src/__tests__/agent-contract.spec.js src/__tests__/ui-standards-validator.spec.js src/__tests__/emulator-environment.spec.js",
    "test:protocol": "vitest run src/__tests__/protocol-helpers.spec.js src/__tests__/arbiter-registry.spec.js src/__tests__/protocol-docx.spec.js src/__tests__/protocol-components.spec.js",
    "test:protocol:coverage": "npm run test:protocol -- --coverage --coverage.include=src/protocol-helpers.js --coverage.include=src/services/arbiter-registry.js --coverage.include=src/services/protocol-docx.js --coverage.reporter=text --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=85 --coverage.thresholds.statements=95",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint": "npm run lint:eslint && npm run stylelint && npm run format:check",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
    "stylelint": "stylelint \"src/**/*.{vue,css}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "lint:fix": "eslint . --fix && npm run stylelint:fix && prettier . --write --log-level warn",
    "check:agent-contract": "node scripts/check-agent-contract.mjs --json",
    "check:ui-standards": "node scripts/check-ui-standards.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "e2e": "node scripts/run-firebase-emulator-suite.mjs all",
    "e2e:ui:emulator": "node scripts/run-firebase-emulator-suite.mjs task11",
    "e2e:ui": "node scripts/run-firebase-emulator-suite.mjs ui",
    "e2e:headed": "node scripts/run-firebase-emulator-suite.mjs headed"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "apexcharts": "5.15.0",
    "docx": "9.7.1",
    "firebase": "12.17.0",
    "html2pdf.js": "^0.14.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "qrcode.vue": "^3.10.0",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue3-apexcharts": "1.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.62.1",
    "@stylistic/stylelint-plugin": "5.2.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "firebase-tools": "15.24.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.25",
    "postcss-html": "^2.0.0",
    "postcss-selector-parser": "7.1.4",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue3-select-component": "^0.16.2"
  }
}
